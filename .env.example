# Copy to .env. This file contains deployment settings, never passwords or tokens.
# Public DNS name resolving to this VPS before certificate issuance.
DOMAIN=proxy.example.com
# IP address or SSH hostname. Keep real values in the ignored .env.
VPS_HOST=192.0.2.10
# Current root/password SSH port supplied by the provider.
BOOTSTRAP_SSH_PORT=22
# Dedicated Ansible account. Never use root for normal deployment.
OPS_USER=ops
# Local private key path; the public key is the same path with .pub appended.
SSH_KEY_PATH=~/.ssh/standalone_3x_ui_ed25519
# yes: add and verify the new port, then remove the old listener/rule.
# no: retain BOOTSTRAP_SSH_PORT. Keeping 22 is an explicit security exception.
CHANGE_SSH_PORT=yes
SSH_TARGET_PORT=2322
# 3x-ui administrator panel. Allow only the CIDRs below.
PANEL_PORT=39089
PANEL_ALLOWED_CIDRS=198.51.100.10/32
# Public subscription endpoint, TCP. Keep separate from the panel and proxy.
SUBSCRIPTION_PORT=38443
# VLESS TLS uses TCP; 443 is the normal public choice.
VLESS_PORT=443
# Hysteria2 is optional. TCP and UDP may both use 443.
ENABLE_HYSTERIA=yes
HYSTERIA_PORT=443
# HTTP-01 certificate issuance needs TCP 80 during setup and renewal.
ACME_EMAIL=
# Exact reviewed installer tag in ansible/playbooks/3x-ui-install.yml.
X_UI_VERSION=v3.9.0


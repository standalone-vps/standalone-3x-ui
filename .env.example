# Copy this file to .env on your Linux computer. Never add passwords or keys here.
# Your public domain. Its DNS record must point to VPS_HOST.
DOMAIN=proxy.example.com
# VPS IP address used for SSH.
VPS_HOST=192.0.2.10
# Port used by root/password SSH before setup. Usually 22.
BOOTSTRAP_SSH_PORT=22
# Account you create on the VPS. Keep ops when following the README.
OPS_USER=ops
# Private key on your Linux computer. The public file has an extra .pub suffix.
SSH_KEY_PATH=~/.ssh/standalone_3x_ui_ed25519
# yes moves SSH to SSH_TARGET_PORT. no keeps the current port.
CHANGE_SSH_PORT=yes
# Example new SSH port: 2322. If CHANGE_SSH_PORT=no, use 22 here too.
SSH_TARGET_PORT=2322
# Panel port. Allow access only from PANEL_ALLOWED_CIDRS.
PANEL_PORT=39089
# Replace with your computer's public IPv4 address plus /32.
PANEL_ALLOWED_CIDRS=198.51.100.10/32
# Public subscription port, TCP. Keep it different from the panel port.
SUBSCRIPTION_PORT=38443
# Public VLESS port, TCP. 443 is the usual choice.
VLESS_PORT=443
# Set no to skip Hysteria2 and its UDP firewall rule.
ENABLE_HYSTERIA=yes
# Hysteria2 uses UDP. It can share the number 443 with VLESS/TCP.
HYSTERIA_PORT=443
# Optional email for the certificate account. Leave empty if unused.
ACME_EMAIL=
# Reviewed installer version. Change only with a reviewed installer update.
X_UI_VERSION=v3.9.0

server {
    listen {{ proxy_fallback_listen_address }}:{{ proxy_fallback_listen_port }} default_server;
    server_name _;
    root {{ proxy_fallback_root }};
    index index.html;
    access_log /var/log/nginx/xray-fallback-access.log;
    error_log /var/log/nginx/xray-fallback-error.log warn;
    location = /api/status {
        default_type application/json;
        alias {{ proxy_fallback_root }}/status.json;
        add_header Cache-Control "no-store" always;
    }
    location / { try_files $uri $uri/ /index.html; }
}

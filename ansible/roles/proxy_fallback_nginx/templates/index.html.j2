<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ proxy_fallback_site_variant.name }}</title>
  <style>
    :root { color-scheme: dark; --background: #0b1220; --surface: #131e2e; --text: #f2f5f9; --muted: #a3b1c2; --accent: {{ proxy_fallback_site_variant.accent }}; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px; background: radial-gradient(circle at 15% 10%, #263b59, transparent 35%), var(--background); color: var(--text); font: 16px/1.55 system-ui, sans-serif; }
    main { width: min(860px, 100%); padding: clamp(28px, 6vw, 64px); border: 1px solid #354358; border-radius: 20px; background: var(--surface); box-shadow: 0 24px 64px #0005; }
    .eyebrow { color: var(--accent); font-weight: 700; letter-spacing: .14em; text-transform: uppercase; font-size: 12px; }
    h1 { margin: 14px 0; font-size: clamp(34px, 6vw, 64px); line-height: 1.05; }
    p { max-width: 620px; color: var(--muted); font-size: 18px; }
    .status { display: inline-block; margin: 16px 0 24px; padding: 7px 12px; border: 1px solid var(--accent); border-radius: 99px; color: var(--accent); font-weight: 700; }
    .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin: 12px 0 28px; }
    .card { padding: 18px; border: 1px solid #354358; border-radius: 12px; }
    .card strong, .card span { display: block; }
    .card span { color: var(--muted); }
    pre { overflow: auto; padding: 20px; border-radius: 12px; background: #080e18; color: #d4e2f4; }
    footer { margin-top: 24px; color: var(--muted); font-size: 13px; }
    @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <main>
    <div class="eyebrow">{{ proxy_fallback_site_variant.name }}</div>
    <h1>{{ proxy_fallback_site_variant.headline }}</h1>
    <p>{{ proxy_fallback_site_variant.description }}</p>
    <div class="status">Service operational</div>
    <section class="grid" aria-label="Service information">
      <div class="card"><strong>Service</strong><span>{{ proxy_fallback_site_variant.product }}</span></div>
      <div class="card"><strong>Node</strong><span>{{ proxy_fallback_site_id }}</span></div>
    </section>
    <pre>GET /api/status

{"service":"{{ proxy_fallback_site_variant.name }}","status":"ok","node":"{{ proxy_fallback_site_id }}"}</pre>
    <footer>HTTPS service endpoint · {{ proxy_fallback_site_id }}</footer>
  </main>
</body>
</html>

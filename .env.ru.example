# Скопируйте файл в .env на компьютере с Linux. Пароли и ключи сюда не добавляйте.
# Ваш домен. Его DNS-запись должна указывать на VPS_HOST.
DOMAIN=proxy.example.com
# IP-адрес VPS для подключения по SSH.
VPS_HOST=192.0.2.10
# Текущий порт входа root по паролю. Обычно 22.
BOOTSTRAP_SSH_PORT=22
# Пользователь, которого вы создаёте на VPS. Для README оставьте ops.
OPS_USER=ops
# Приватный ключ на компьютере с Linux. У публичного файла добавлено .pub.
SSH_KEY_PATH=~/.ssh/standalone_3x_ui_ed25519
# yes переносит SSH на SSH_TARGET_PORT. no оставляет прежний порт.
CHANGE_SSH_PORT=yes
# Пример нового SSH-порта: 2322. При CHANGE_SSH_PORT=no здесь тоже нужен 22.
SSH_TARGET_PORT=2322
# Порт панели. Панель доступна с любого IPv4-адреса.
PANEL_PORT=39089
# Открыть панель для любого IPv4-адреса.
PANEL_ALLOWED_CIDRS=0.0.0.0/0
# Публичный порт подписки, TCP. Он должен отличаться от порта панели.
SUBSCRIPTION_PORT=38443
# Публичный порт VLESS, TCP. Обычно используют 443.
VLESS_PORT=443
# no отключает Hysteria2 и правило фаервола для UDP.
ENABLE_HYSTERIA=yes
# Hysteria2 использует UDP. Номер 443 можно разделить с VLESS/TCP.
HYSTERIA_PORT=443
# Проверенная версия установщика. Меняйте только после проверки нового установщика.
X_UI_VERSION=v3.9.0

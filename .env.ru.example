# Скопируйте в .env. Здесь только параметры, без паролей и токенов.
# Публичное DNS-имя VPS; до выпуска сертификата оно должно указывать на сервер.
DOMAIN=proxy.example.com
# IP-адрес или SSH-имя сервера. Реальное значение храните в игнорируемом .env.
VPS_HOST=192.0.2.10
# Текущий порт входа root по паролю от провайдера.
BOOTSTRAP_SSH_PORT=22
# Отдельный пользователь для Ansible; постоянный вход root не используется.
OPS_USER=ops
# Локальный приватный SSH-ключ. Публичный имеет тот же путь с суффиксом .pub.
SSH_KEY_PATH=~/.ssh/standalone_3x_ui_ed25519
# yes: открыть и проверить новый порт, затем закрыть старый.
# no: оставить BOOTSTRAP_SSH_PORT. Сохранение порта 22 — осознанное исключение.
CHANGE_SSH_PORT=yes
SSH_TARGET_PORT=2322
# Административная панель 3x-ui: разрешить доступ только указанным адресам.
PANEL_PORT=39089
PANEL_ALLOWED_CIDRS=198.51.100.10/32
# Публичный TCP-порт подписки; отдельно от панели и прокси.
SUBSCRIPTION_PORT=38443
# VLESS/TLS использует TCP; обычный публичный вариант — 443.
VLESS_PORT=443
# Hysteria2 необязательна; TCP и UDP могут иметь одинаковый номер 443.
ENABLE_HYSTERIA=yes
HYSTERIA_PORT=443
# Для выпуска и продления сертификата через HTTP-01 нужен TCP 80.
ACME_EMAIL=
# Точный проверенный тег из ansible/playbooks/3x-ui-install.yml.
X_UI_VERSION=v3.9.0
